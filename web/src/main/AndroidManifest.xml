<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries><package android:name="com.desktopmini.tv" /></queries>
    <!-- App phụ của Desktop Mini: không có biểu tượng riêng trong danh sách app; Desktop Mini mở "Trình duyệt" và "Ổ mềm" bằng intent tường minh -->
    <application android:label="Trình duyệt và Ổ mềm TV" android:allowBackup="false" android:largeHeap="true"
        android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".BrowserActivity" android:icon="@drawable/ic_browser" android:label="Trình duyệt" android:exported="true"
            android:launchMode="singleTask" android:taskAffinity="com.desktopmini.tvweb.browser"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|uiMode" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".OmemActivity" android:icon="@drawable/ic_omem" android:label="Ổ mềm" android:exported="true"
            android:launchMode="singleTask" android:taskAffinity="com.desktopmini.tvweb.omem"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|uiMode" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
